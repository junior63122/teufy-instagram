 "scenes": [
  {
   "id": "accroche",
   "texte": "[shocked] Ton billet est passé de douze à vingt-cinq euros… en UNE nuit ?!",
   "sons": [
    {
     "son": "basse",
     "mot": "vingt-cinq",
     "volume": 0.7
    }
   ],
   "start": 0,
   "end": 4.745
  },
  {
   "id": "paliers",
   "texte": "[curious] Non, c'est pas une arnaque. C'est le système des PALIERS.",
   "sons": [
    {
     "son": "pop",
     "mot": "paliers",
     "volume": 0.55
    }
   ],
   "start": 4.745,
   "end": 7.7
  },
  {
   "id": "trois",
   "texte": "Les premières places, les early, partent à prix cassé. Puis ça monte : regular… et last.",
   "sons": [
    {
     "son": "pop",
     "mot": "early",
     "volume": 0.5
    },
    {
     "son": "pop",
     "mot": "regular",
     "volume": 0.5
    },
    {
     "son": "basse",
